<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  DataNest MinIO S3A 配置（Sprint 8 实时 CDC）
  flink-s3-fs-hadoop 的 S3AFileSystem 从 Hadoop Configuration 读取 fs.s3a.*
  凭据优先用环境变量（compose 已注入），这里只固定 endpoint/path-style
-->
<configuration>
    <property>
        <name>fs.s3a.endpoint</name>
        <value>http://middleware-minio:9000</value>
    </property>
    <property>
        <name>fs.s3a.path.style.access</name>
        <value>true</value>
    </property>
    <property>
        <name>fs.s3a.connection.ssl.enabled</name>
        <value>false</value>
    </property>
</configuration>
