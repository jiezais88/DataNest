<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-apis</artifactId>
    <packaging>pom</packaging>
    <name>DataNest APIs</name>
    <description>DataNest Feign contract aggregator</description>

    <modules>
        <module>data-nest-alert-api</module>
        <module>data-nest-system-api</module>
        <module>data-nest-engineering-api</module>
        <module>data-nest-governance-api</module>
        <module>data-nest-realtime-api</module>
        <module>data-nest-data-service-api</module>
    </modules>

    <!-- Feign 契约模块公共依赖（各 *-api 子模块自动继承；消费方依赖任一 api 模块即传递获得完整容错三件套） -->
    <dependencies>
        <!-- DataNest Common（Result 信封） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- OpenFeign（compile 作用域，消费方依赖本模块时传递获得 Feign） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Resilience4j 熔断（compile 作用域，消费方依赖本模块时传递获得，供 Feign fallbackFactory 生效） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Apache HttpClient 5（compile 传递，消费方 Feign 走 HC5 连接池，替代无池的 JDK HttpURLConnection） -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hc5</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
