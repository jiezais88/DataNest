<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest-service-webmvc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../data-nest-service-webmvc/pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-alert-service</artifactId>
    <packaging>jar</packaging>
    <name>DataNest Alert Service</name>
    <description>Alert center microservice: alert rule CRUD, alert firing, DAG alert and mail</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- DataNest Alert API（自身 Feign 契约，内部 Controller 复用其请求 DTO） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-alert-api</artifactId>
        </dependency>

        <!-- 跨域 Feign 契约：用户（system）/ 对象（engineering / governance） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-engineering-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-governance-api</artifactId>
        </dependency>
        <!-- Sprint 9 F3：CDC 管道对象名反查/可选对象下拉（realtime 内部端点） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-realtime-api</artifactId>
        </dependency>

        <!-- Fastjson2（触发条件 JSON 解析/序列化） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 邮件（告警服务自己发信） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
    </dependencies>
</project>
