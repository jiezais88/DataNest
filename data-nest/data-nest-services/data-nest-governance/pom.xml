<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest-service-webmvc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../data-nest-service-webmvc/pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-governance</artifactId>
    <name>DataNest Governance Service</name>
    <description>DataNest Governance Service - Metadata Collection &amp; Scheduling</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- DataNest Task Core -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-task-core</artifactId>
        </dependency>

        <!-- DataNest Alert API（微服务化改造：告警域调用切换为 Feign） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-alert-api</artifactId>
        </dependency>

        <!-- DataNest Governance API（内部接口复用契约 DTO） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-governance-api</artifactId>
        </dependency>

        <!-- DataNest Engineering API（微服务化 3.4：datasource_connection 跨服务读取改 Feign，直接使用需显式声明） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-engineering-api</artifactId>
        </dependency>

        <!-- DataNest System API（微服务化 4.3：原经 task-core-governance 传递，模块拆除后显式声明） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-system-api</artifactId>
        </dependency>

        <!-- Fastjson2（task-core 中为 provided，需在本服务显式声明，否则 AlertRuleService 等报 ClassNotFoundException） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2-extension</artifactId>
        </dependency>

        <!-- Sprint 6 质量分级告警：governance 注入 QualityCheckService → AlertFiringService → MailService，需显式声明 mail（task-core 中为 provided） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Caffeine cache for LoadBalancer service instance cache (production cache implementation) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- JDBC Drivers（Doris 走 MySQL 协议；外部数据源直连） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache POI（xlsx 导出统一框架，2026-08-11 起取代 Commons CSV；poi-ooxml 默认带 lite schemas，
             不引 poi-ooxml-full 全量 schema 包；配合 XlsxExportHelper 使用；版本统一由根 pom dependencyManagement 管理） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
