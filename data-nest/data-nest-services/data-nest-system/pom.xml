<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest-service-webmvc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../data-nest-service-webmvc/pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-system</artifactId>
    <packaging>jar</packaging>
    <name>DataNest System Service</name>
    <description>User and permission management service</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- BCrypt (spring-boot-starter-security 自带，但这里只引入 crypto) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Sprint 14 SSO：OIDC id_token 验签（决策 D8 自研客户端，版本根 pom 管理） -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- Sprint 14 SSO：LDAP 编程式接入（spring-ldap-core；未配 spring.ldap.urls 时自动配置不生效，无冲突） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-ldap</artifactId>
        </dependency>

        <!-- Fastjson2（JSON 解析：OIDC token/Discovery 响应；版本根 pom 管理） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- LdapClientService 使用 javax.naming（java.naming 模块），JDK 9+ classpath 编译需显式 add-modules -->
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>java.naming</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
