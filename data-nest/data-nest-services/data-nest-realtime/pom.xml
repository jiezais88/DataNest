<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest-service-webmvc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../data-nest-service-webmvc/pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-realtime</artifactId>
    <packaging>jar</packaging>
    <name>DataNest Realtime Service</name>
    <description>Realtime CDC pipeline microservice: pipeline CRUD, Flink CDC YAML submit, Iceberg lakehouse sink</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- DataNest Realtime API（自身 Feign 契约，内部 Controller 复用其 DTO） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-realtime-api</artifactId>
        </dependency>

        <!-- 跨域 Feign 契约：数据源连接信息（engineering） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-engineering-api</artifactId>
        </dependency>

        <!-- 跨域 Feign 契约：创建人/更新人用户名回填（system） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-system-api</artifactId>
        </dependency>

        <!-- 跨域 Feign 契约：流处理告警上报（Sprint 9 F3，app-alert 不可达降级不阻断监控） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-alert-api</artifactId>
        </dependency>

        <!-- MinIO Java Client：savepoint 文件物理清理（Sprint 9 F2，配置复用 shared-minio.yaml） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- fastjson2：configJson 高级配置解析（项目统一 JSON 库） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- ========== Flink CDC 提交端依赖集（Sprint 8 M0 验证范本 tmp/m0-cdc-verify/pom.xml 照抄；
             版本统一由根 pom cdc.version/flink.version/flink-shaded-guava.version 管理，勿在子模块重复声明） ========== -->
        <!-- CDC YAML 解析 + 作业组装 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-composer</artifactId>
        </dependency>
        <!-- composer 的 provided 依赖，显式声明 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-flink2-compat</artifactId>
        </dependency>

        <!-- pipeline connector：提交端加载 Factory（运行时 jar 已预置集群 /opt/flink/lib） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-pipeline-connector-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-pipeline-connector-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-pipeline-connector-iceberg</artifactId>
        </dependency>
        <!-- Kafka 单 sink 事件作业提交端依赖（F4 WebSocket 实时订阅：YAML 解析时识别 kafka sink Factory；
             运行时 jar 已预置集群 /opt/flink/lib） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-pipeline-connector-kafka</artifactId>
        </dependency>
        <!-- mysql connector 不含 JDBC 驱动，需手动带；源库预检也走它。
             8.x 线对齐 Flink CDC 依赖（版本统一由根 pom mysql-connector.version 管理，勿改） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
        </dependency>

        <!-- 远程提交客户端（composer 中 provided，显式声明对齐集群 2.2.1） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
        </dependency>

        <!-- flink-core 2.2.1 需要 flink-shaded-guava 33.4.0（CDC 传递依赖带的是 31.1，版本由根 pom 锁定） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-shaded-guava</artifactId>
        </dependency>

        <!-- CDC source/sink 运行时的 flink-connector-base（Flink 发行版不内置） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
        </dependency>

        <!-- 提交端序列化 stream node 需要 flink-table-common -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
        </dependency>
        <!-- ========== Flink CDC 依赖集结束 ========== -->
    </dependencies>
</project>
