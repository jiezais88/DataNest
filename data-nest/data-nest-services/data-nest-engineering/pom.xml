<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest-service-webmvc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../data-nest-service-webmvc/pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-engineering</artifactId>
    <packaging>jar</packaging>
    <name>DataNest Engineering Service</name>
    <description>Data source connection and data engineering service</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- DataNest Task Core -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-task-core</artifactId>
        </dependency>

        <!-- DataNest Alert API（微服务化改造：告警域调用切换为 Feign） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-alert-api</artifactId>
        </dependency>

        <!-- DataNest Engineering API（内部接口复用契约 DTO） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-engineering-api</artifactId>
        </dependency>

        <!-- DataNest Governance API（微服务化 3.4：治理表跨域读写改 Feign） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-governance-api</artifactId>
        </dependency>

        <!-- DataNest Realtime API（Sprint 8 F2：数据源删除前 CDC 管道引用校验） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-realtime-api</artifactId>
        </dependency>

        <!-- DataNest System API（微服务化 4.3：原经 task-core-governance 传递，模块拆除后显式声明） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-system-api</artifactId>
        </dependency>

        <!-- JDBC Drivers（数据源直连：Doris 走 MySQL 协议） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sprint 4：DAG 邮件告警 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Fastjson2（Sprint 3 起统一 JSON 序列化，替代 Jackson ObjectMapper） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2-extension</artifactId>
        </dependency>

        <!-- Sprint 3 性能优化：DagExecutionSyncService 使用 Caffeine 本地缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
    </dependencies>
</project>
