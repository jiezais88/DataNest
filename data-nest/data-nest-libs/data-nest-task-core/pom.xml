<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.datanest</groupId>
        <artifactId>data-nest</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>data-nest-task-core</artifactId>
    <packaging>jar</packaging>
    <name>DataNest Task Core</name>
    <description>Shared task execution core for data synchronization and metadata collection</description>

    <dependencies>
        <!-- DataNest Common -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-common</artifactId>
        </dependency>

        <!-- DataNest Task Core Entity（共享实体/mapper/constant/dto 底座） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-task-core-entity</artifactId>
        </dependency>

        <!-- DataNest Alert API（微服务化改造：执行类经 Feign 远程触发告警） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-alert-api</artifactId>
        </dependency>

        <!-- DataNest Task Core Governance（执行内核调用质量自动触发等治理编排服务） -->
        <dependency>
            <groupId>com.datanest</groupId>
            <artifactId>data-nest-task-core-governance</artifactId>
        </dependency>

        <!-- Spring Context (provided by consumers) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Web (provided by consumers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 分页/乐观锁等 jsqlparser 系拦截器（task-core 自动配置需要，消费方服务自身已引入）。
             该依赖传递引入 jsqlparser 5.2（net.sf.jsqlparser 包，与历史 4.9 API 兼容），
             SQL 血缘/元数据解析直接复用，不再单独声明 jsqlparser，避免版本仲裁冲突。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JDBC Drivers -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sa-Token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sprint 4：Python 节点、血缘等使用 fastjson2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sprint 3 性能优化：Dag 信息本地缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sprint 3 P1-4：HikariCP 连接池（DorisSqlExecutor 用） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sprint 3 P1-4：JDBC 抽象 + Spring 数据源基础设施（HikariCP 配置需要） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
